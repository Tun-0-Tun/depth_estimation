{
  "name": "zju_l5_vis_5_local_inr_dd",
  "dataset": "zju_l5",
  "mat_path": "data/nyu_depth_v2/nyu_depth_v2_labeled.mat",
  "zju_l5_root": "data/ZJUL5",
  "zju_l5_manifest": "data.json",
  "zju_l5_split": "test",
  "prior_source": "l5_zones",
  "num_samples": 5,
  "sparse_density": 0.3,
  "seed": 42,
  "model_id": "depth-anything/Depth-Anything-V2-Small-hf",
  "out_dir": "./outputs/experiments",
  "show_prediction_diff": true,
  "figure_suptitle": false,
  "method_column_titles": {
    "local_bilateral": "Local bilateral",
    "inr_sr": "INR-FiLM",
    "dd_cnn": "DD-CNN"
  },
  "methods": {
    "local_bilateral": {
      "type": "local",
      "n_segments": 200,
      "smooth_mode": "bilateral",
      "sigma_spatial": 6.0,
      "range_scale": 0.25,
      "bilateral_max_radius": 10,
      "min_pixels": 10
    },
    "inr_sr": {
      "type": "inr_film",
      "n_segments": 400,
      "crop_size": 32,
      "d_c": 64,
      "hidden_dim": 128,
      "num_film_layers": 4,
      "num_frequencies": 6,
      "train_steps": 800,
      "lr": 0.001,
      "affine_baseline": true,
      "train_seed": 42,
      "film_context_blur_mode": "soft_assign",
      "film_context_soft_k": 16,
      "film_context_soft_sigma_px": 80.0,
      "use_region_geom": true,
      "tv_lambda": 0.05,
      "tv_pairs_per_step": 8192,
      "tv_color_kappa": 10.0,
      "output_refine_mode": "guided",
      "output_refine_radius": 24,
      "output_refine_eps": 0.0001
    },
    "dd_cnn": {
      "type": "direct_depth_cnn",
      "hidden_dim": 64,
      "num_layers": 8,
      "train_steps": 800,
      "lr": 0.0003,
      "train_seed": 42,
      "smooth_lambda": 0.08,
      "smooth_color_kappa": 12.0,
      "prior_lambda": 0.02,
      "output_refine_mode": "guided",
      "output_refine_radius": 8,
      "output_refine_eps": 0.001
    }
  }
