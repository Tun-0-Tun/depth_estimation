{
  "name": "nyu_rel2metric_eval",
  "dataset": "nyu",
  "mat_path": "data/nyu_depth_v2/nyu_depth_v2_labeled.mat",
  "seed": 42,
  "model_id": "depth-anything/Depth-Anything-V2-Small-hf",
  "out_dir": "./outputs/experiments",
  "prior_source": "grid_stride",
  "prior_grid_stride": 20,
  "prior_noise": {
    "relative_std": 0.02,
    "absolute_std_m": 0.02,
    "outlier_fraction": 0.02,
    "outlier_amp_m": 0.5
  },
  "frame_indices_file": "configs/metadata/nyu_heldout_val100.json",
  "show_prediction_diff": true,
  "methods": {
    "rel2metric_tta": {
      "type": "rel2metric_tta",
      "checkpoint": "outputs/rel2metric/rel2metric_mixed.pt",
      "tta_steps": 150,
      "tta_lr": 2e-3,
      "tta_smooth_lambda": 0.05,
      "tta_prox_lambda": 0.1,
      "tta_trim_frac": 0.1,
      "output_refine_mode": "guided",
      "output_refine_radius": 8,
      "output_refine_eps": 0.001
    },
    "rel2metric_no_tta": {
      "type": "rel2metric_tta",
      "checkpoint": "outputs/rel2metric/rel2metric_mixed.pt",
      "tta_steps": 0,
      "output_refine_mode": "guided"
    },
    "local_bilateral": {
      "type": "local",
      "n_segments": 200,
      "smooth_mode": "bilateral",
      "sigma_spatial": 5.0,
      "range_scale": 0.25,
      "bilateral_max_radius": 10,
      "min_pixels": 10
    }
  }
}
