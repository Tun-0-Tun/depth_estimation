{
  "name": "zju_l5_direct_depth_v1",
  "dataset": "zju_l5",
  "mat_path": "data/nyu_depth_v2/nyu_depth_v2_labeled.mat",
  "zju_l5_root": "data/ZJUL5",
  "zju_l5_manifest": "data.json",
  "zju_l5_split": "test",
  "prior_source": "l5_zones",
  "num_samples": 10,
  "sparse_density": 0.3,
  "seed": 42,
  "model_id": "depth-anything/Depth-Anything-V2-Small-hf",
  "out_dir": "./outputs/experiments",
  "show_prediction_diff": true,
  "methods": {
    "direct_depth_cnn_v1": {
      "type": "direct_depth_cnn",
      "hidden_dim": 64,
      "num_layers": 8,
      "train_steps": 800,
      "lr": 0.0003,
      "train_seed": 42,
      "smooth_lambda": 0.08,
      "smooth_color_kappa": 12.0,
      "prior_lambda": 0.02,
      "output_refine_mode": "guided",
      "output_refine_radius": 8,
      "output_refine_eps": 0.001
    },
    "v3_softblend_refined": {
      "type": "inr_film",
      "n_segments": 150,
      "crop_size": 32,
      "d_c": 64,
      "hidden_dim": 128,
      "num_film_layers": 4,
      "num_frequencies": 6,
      "train_steps": 800,
      "lr": 0.001,
      "affine_baseline": true,
      "train_seed": 42,
      "film_context_blur_mode": "soft_assign",
      "film_context_soft_k": 6,
      "film_context_soft_sigma_px": 30.0,
      "use_region_geom": true,
      "tv_lambda": 0.05,
      "tv_pairs_per_step": 4096,
      "tv_color_kappa": 10.0,
      "output_refine_mode": "guided",
      "output_refine_radius": 8,
      "output_refine_eps": 0.001
    },
    "local_bilateral": {
      "type": "local",
      "n_segments": 200,
      "smooth_mode": "bilateral",
      "sigma_spatial": 6.0,
      "range_scale": 0.25,
      "bilateral_max_radius": 10,
      "min_pixels": 10
    }
  }
}
